lBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P1" target="B3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="B3" target="D7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="no: やり直し&lt;br&gt;(P が別の反撃を出す)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D7" target="B3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2230" y="320"/><mxPoint x="2230" y="125"/></Array></mxGeometry></mxCell><mxCell id="c18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D7" target="O2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="O2" target="B2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="no: O は A1 への&lt;br&gt;別の攻撃を探す" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="O2" target="O1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2060" y="875"/><mxPoint x="1120" y="875"/></Array></mxGeometry></mxCell><mxCell id="c21" value="no&lt;br&gt;(A1 を打ち負かす argument がない)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="O1" target="J"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="780"/></Array></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.3889;entryDx=0;entryDy=0;" edge="1" parent="1" source="J" target="F"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P1" target="D9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="125"/></Array></mxGeometry></mxCell><mxCell id="c24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D9" target="DF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D9" target="OV"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="DF" target="c1df"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="OV" target="c1ov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gloss" value="&lt;b&gt;用語&lt;/b&gt;&lt;br&gt;・main argument: エージェントが自分の立場から出す、議論の中心になる主張(argument)&lt;br&gt;・rebut: 相手の argument の結論と矛盾する結論を導いて攻撃する&lt;br&gt;・undercut: 相手が前提にしている「弱い仮定」を崩して攻撃する&lt;br&gt;・defeat: 攻撃が成功して、相手の argument を打ち負かす&lt;br&gt;・strictly defeat: defeat し、かつ相手から defeat し返されない&lt;br&gt;・justified: 反論できる argument がない / overruled: 反論に負け、挽回する反撃もない / defensible: どちらとも決まらない" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="920" width="1100" height="150" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;補足&lt;/b&gt;&lt;br&gt;・どの段階でも、ターン数の上限に達したらその main argument は defensible のまま打ち切る。1つの main argument が使えるのは上限の半分まで(1つの議論で上限を使い切らないため)。&lt;br&gt;・全体の上限に達して、justified も統合もないときは、AG1 が統合してから終了処理に進む(この統合の状態は決めない)。&lt;br&gt;・統合で出した main argument の状態も、上と同じ手順で決める(上限で統合した場合を除く)。&lt;br&gt;・無効な攻撃(defeat / strictly defeat になっていないもの)は議論の履歴に入れず、やり直させる。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="920" width="1030" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>