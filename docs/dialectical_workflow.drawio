;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="T" target="F"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1top" target="D2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="O1" value="A1 を&lt;br&gt;rebut / undercut&lt;br&gt;できる？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995.0" y="715.0" width="250" height="130" as="geometry"/></mxCell><mxCell id="B2" value="直前の argument を&lt;br&gt;攻撃する argument を出す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1615.0" y="750.0" width="170" height="60" as="geometry"/></mxCell><mxCell id="D5" value="有効な攻撃に&lt;br&gt;なっている？&lt;br&gt;(defeat している)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1575.0" y="255.0" width="250" height="130" as="geometry"/></mxCell><mxCell id="P1" value="その攻撃を&lt;br&gt;rebut / undercut&lt;br&gt;できる？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1575.0" y="60.0" width="250" height="130" as="geometry"/></mxCell><mxCell id="B3" value="反撃する&lt;br&gt;argument を出す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1980.0" y="95.0" width="160" height="60" as="geometry"/></mxCell><mxCell id="D7" value="反撃になっている？&lt;br&gt;(strictly defeat&lt;br&gt;している)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935.0" y="255.0" width="250" height="130" as="geometry"/></mxCell><mxCell id="O2" value="その反撃を&lt;br&gt;rebut / undercut&lt;br&gt;できる？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935.0" y="715.0" width="250" height="130" as="geometry"/></mxCell><mxCell id="J" value="A1 は&lt;br&gt;&lt;b&gt;justified&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790.0" y="420.0" width="160" height="60" as="geometry"/></mxCell><mxCell id="D9" value="P は、すでに&lt;br&gt;defeat する反撃を&lt;br&gt;出した？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170.0" y="385.0" width="240" height="130" as="geometry"/></mxCell><mxCell id="DF" value="A1 は&lt;br&gt;&lt;b&gt;defensible&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450.0" y="420.0" width="120" height="60" as="geometry"/></mxCell><mxCell id="OV" value="A1 は&lt;br&gt;&lt;b&gt;overruled&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230.0" y="570.0" width="120" height="60" as="geometry"/></mxCell><mxCell id="c1df" value="①" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1492.0" y="522.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c1ov" value="①" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f