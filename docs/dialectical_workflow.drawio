width="70" height="70" as="geometry"/></mxCell><mxCell id="D2" value="main argument を&lt;br&gt;出せる？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260.0" y="65.0" width="220" height="120" as="geometry"/></mxCell><mxCell id="B1" value="main argument&lt;br&gt;(A1) を出す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040.0" y="95.0" width="160" height="60" as="geometry"/></mxCell><mxCell id="D3" value="2回続けて&lt;br&gt;出せなかった？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260.0" y="260.0" width="220" height="120" as="geometry"/></mxCell><mxCell id="T" value="&lt;b&gt;統合する&lt;/b&gt;(1回だけ)&lt;br&gt;両者の main argument から&lt;br&gt;新しい rule を作り、&lt;br&gt;それを使った main argument を出す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260.0" y="415.0" width="220" height="90" as="geometry"/></mxCell><mxCell id="F" value="&lt;b&gt;終了処理&lt;/b&gt;&lt;br&gt;各 main argument の&lt;br&gt;状態を確定し、&lt;br&gt;AG1 が最終回答を書く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520.0" y="415.0" width="220" height="90" as="geometry"/></mxCell><mxCell id="end" value="終了" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600.0" y="570.0" width="60" height="60" as="geometry"/></mxCell><mxCell id="c1top" value="①" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="352.0" y="15.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c1note" value="① = 手番を相手に交代して、ここへ戻る" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><m